#!/usr/bin/env bash
# Bar widget uninstall worker (BarWatch.qml's startUninstall runs this
# detached). Runs the official CLI uninstall (omarchy plugin remove --yes)
# per plugin id, mirroring its id validation (same pattern as the CLI's
# valid_plugin_id), then fires one rescan so the bar drops uninstalled icons.
# The CLI unloads an enabled plugin from the shell itself; a symlinked
# plugin (dev clone) is only unlinked, never followed. Detached like the
# update worker, so uninstalling this manager itself still finishes and
# notifies after the shell reload destroys the widget.
set -u
# Marker files record in-progress batches (mode, timestamps); owner-only
# from creation, whatever the caller's umask.
umask 077
export PATH="${OMARCHY_PATH:-/usr/share/omarchy}/bin:$PATH"
notify_cmd="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-notification-send"
command -v "$notify_cmd" >/dev/null 2>&1 || notify_cmd="$(command -v omarchy-notification-send 2>/dev/null || echo omarchy-notification-send)"
notify() {
  "$notify_cmd" --app-name omarchy-browser-plugin-manager --expire-time 8000 "$1" "$2"
}
real_shell="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-shell"
command -v "$real_shell" >/dev/null 2>&1 || real_shell="$(command -v omarchy-shell 2>/dev/null || echo /usr/share/omarchy/bin/omarchy-shell)"

# Built-in (first-party) plugins are part of the Omarchy install itself: the
# official CLI uninstall only ever acts on the user plugins directory
# (~/.config/omarchy/plugins) and refuses them with "not installed". Read the
# live list once up front, so those ids get the actionable answer instead of a
# CLI failure, while the rest of the batch still runs.
first_party_ids=$(omarchy plugin list --json 2>/dev/null \
  | jq -r '[.[]? | select(type == "object" and .firstParty == true) | .id] | .[]' 2>/dev/null || true)
is_first_party() {
  [ -n "$first_party_ids" ] || return 1
  printf '%s\n' "$first_party_ids" | grep -qxF -- "$1"
}

# In-progress system panel (same protocol as the wizard's workers): the
# first argv is a display label (plugin name, or "N plugins" for a
# batch); publish a marker file per run (removed on any exit) and summon
# the wizard on its running stage, which polls the marker directory and
# closes itself once no fresh marker remains.
LABEL="${1:-plugins}"; [ $# -gt 0 ] && shift
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/bramvanoploo.omarchy-browser-plugin-manager"
MARK_DIR="$STATE_DIR/in-progress"
mkdir -p "$MARK_DIR" 2>/dev/null || true
MARK="$MARK_DIR/$$-$(date +%s)-${RANDOM:-0}.json"
trap 'rm -f "$MARK"' EXIT
jq -cn --arg mode "uninstall" --arg name "$LABEL" '{mode:$mode,id:"",name:$name,started:(now|floor)}' > "$MARK" 2>/dev/null || true
PAYLOAD=$(jq -cn --arg name "$LABEL" '{source:"worker",mode:"running",id:"",name:$name,action:"uninstall"}' 2>/dev/null)
[ -n "$PAYLOAD" ] && "$real_shell" -q shell summon bramvanoploo.omarchy-browser-plugin-manager "$PAYLOAD" >/dev/null 2>&1 || true

ok=0; fail=0; failed=""; builtin=0; builtins=""
while [ $# -gt 0 ]; do
  id="$1"
  case "$id" in ''|[!a-z0-9]*|*[!a-z0-9.-]*|*..*) id="" ;; esac
  if [ -z "$id" ]; then
    fail=$((fail+1)); failed="$failed $id"
  elif is_first_party "$id"; then
    builtin=$((builtin+1)); builtins="$builtins $id"
  else
    if [ "$id" = "bramvanoploo.omarchy-browser-plugin-manager" ]; then
      plug="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/bramvanoploo.omarchy-browser-plugin-manager"
      if [ -x "$plug/bin/plugin-installer-setup" ]; then
        "$plug/bin/plugin-installer-setup" --uninstall >/dev/null 2>&1 || true
      fi
      # Forget extension presence and any left-click dialog decline: both
      # gate files describe this plugin's browser relationship, so a
      # fresh install re-offers the extension (the extension's own
      # heartbeats rebuild the seen stamps once it is installed again).
      rm -f "$STATE_DIR/browser-extension-seen.json" "$STATE_DIR/browser-prompt-dismissed.json"
    fi
    if omarchy plugin remove "$id" --yes >/dev/null 2>&1; then
      ok=$((ok+1))
    else
      fail=$((fail+1)); failed="$failed $id"
    fi
  fi
  shift
done
if [ "$ok" -gt 0 ]; then
  "$real_shell" -q shell rescanPlugins >/dev/null 2>&1 || true
fi
if [ "$builtin" -gt 0 ]; then
  if [ "$builtin" -gt 1 ]; then
    notify "Cannot uninstall built-in plugins" "${builtins# } ship with Omarchy, so they cannot be uninstalled. Turn them off instead, one id at a time: omarchy plugin disable <id>."
  else
    notify "Cannot uninstall built-in plugin" "${builtins# } ships with Omarchy, so it cannot be uninstalled. Turn it off instead: omarchy plugin disable ${builtins# }."
  fi
fi
if [ "$fail" -gt 0 ]; then
  notify "Uninstall finished with failures" "$ok uninstalled, $fail failed:$failed"
elif [ "$ok" -gt 0 ]; then
  notify "Plugins uninstalled" "$ok plugin(s) uninstalled."
elif [ "$builtin" -eq 0 ]; then
  notify "Nothing uninstalled" "No plugin was uninstalled."
fi
