#!/bin/bash
# Native messaging host for the Omarchy PlugBrug browser extension.
# Speaks Chrome/Firefox native messaging: 4-byte little-endian length + JSON.
#
# Messages from the extension:
#   {"type":"ping"}
#   {"type":"status","id":"acme.weather"}
#   {"type":"status_all"}
#   {"type":"install","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"uninstall","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"enable","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"disable","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"watch","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"watch","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather","paused":true}
#   {"type":"unwatch","id":"acme.weather"}
#   {"type":"update","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"placement","id":"acme.weather","repo":"https://github.com/acme/weather.git","name":"Weather"}
#   {"type":"visit","source":"firefox","key":"a1b2c3","url":"https://plugins.omarchy.org/plugin.html?id=x"}
#   {"type":"unvisit","key":"a1b2c3"}
#   {"type":"updates"}
#
# "updates" answers the behind-set from a cached git-ancestry check (the same
# omaplug-parity model the bar widget polls: fetch origin HEAD + merge-base),
# decorated with the catalog's latest version and verification status. The
# cache lives in the state dir and is refreshed by a detached worker behind
# a non-blocking lock (status polling must never block on git). The
# "Update to unverified version" setting (the bar's settings.json) is applied
# here: with it off, unverified updates are hidden from every reply.
#
# This host NEVER installs anything itself. It validates a request against a
# fresh fetch of the marketplace catalog, then summons the wizard overlay,
# which re-validates, asks the user to confirm, and runs the omarchy plugin
# command. The outcome is a desktop notification; no completion dialog shows.
#
# "watch" is the bar-icon watcher beacon: a tab on a manageable plugin page
# in a focused browser window sends it every few seconds, "watch" with
# "paused":true when the window loses focus, and "unwatch" when the tab
# hides or the page closes. The host only format-checks id/repo (no catalog
# fetch, no action) and records the page in browser-watch.json in the state
# dir; the bar widget shows the plugin while that record is live, and its
# dropdown routes every action through the wizard, which re-validates.
# "unwatch" removes the record right away (the widget shows its placeholder);
# a lost beacon (browser killed) goes stale on its own.
#
# "visit" is the presence heartbeat: any tab on a plugins.omarchy.org page
# (catalog or detail, focused or not) sends it every couple of seconds with
# its browser source, a per-page-load key, and its url. The host keeps a
# per-tab record in browser-tabs.json (stale entries age out) so the bar
# widget knows a marketplace tab is open; a left click on the bar icon then
# writes a focus request to browser-focus.json. The next visit heartbeat
# consumes that request (stamps consumedBy, answers activate:true) and the
# extension raises its tab and focuses the window. "unvisit" drops the
# tab's record when the page closes.

set -euo pipefail
# The state dir holds the marketplace presence heartbeats (which pages the
# user has open), so every file this host creates must be owner-only from the
# moment it exists, whatever the caller's umask is (a 022 umask would make
# the records world-readable). Children (git, the shell) run as the same user,
# so nothing outside this account needs read access.
umask 077
# Qt (used by omarchy-shell / omarchy plugin list) writes a warning to stdout
# if the locale is non-UTF-8 ("C" / "POSIX"). Force C.UTF-8 for child processes
# and scope LC_ALL=C locally when measuring exact byte lengths.
export LC_ALL=C.UTF-8

HOST_NAME="bramvanoploo_omarchy_browser_plugin_manager"
HOST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST_VERSION="$(jq -r '.version // empty' "$HOST_DIR/../manifest.json" 2>/dev/null || true)"
if [[ -z "$HOST_VERSION" ]]; then
  HOST_VERSION="1.0.0"
fi
# The extension's transport can touch the manifest, so a tampered version
# string must never travel into a reply frame as raw bytes: keep only a
# conservative version-shaped token, and fall back to the built-in default.
[[ "$HOST_VERSION" =~ ^[0-9A-Za-z.+-]{1,32}$ ]] || HOST_VERSION="1.0.0"
CATALOG_URL="https://plugins.omarchy.org/catalog.json"
WIZARD_ID="bramvanoploo.omarchy-browser-plugin-manager"
MAX_FRAME_BYTES=65536
# Watcher-mode beacon record: the plugin page of the tab(s) currently open.
# The bar widget reads this file; it is written here and removed by
# "unwatch" and by the host's exit trap.
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/$WIZARD_ID"
WATCH_FILE="$STATE_DIR/browser-watch.json"
# Presence heartbeats from every marketplace tab (browser-tabs.json) and the
# bar widget's focus request (browser-focus.json). Neither is removed by the
# exit trap: tab records age out by ts, and a focus request is consumed by
# the next heartbeat (or discarded as stale).
TABS_FILE="$STATE_DIR/browser-tabs.json"
FOCUS_FILE="$STATE_DIR/browser-focus.json"
TABS_LOCK_FILE="$STATE_DIR/browser-tabs.lock"
WATCH_LOCK_FILE="$STATE_DIR/browser-watch.lock"
# Browser-extension install evidence (browser-extension-seen.json):
# {chrome: ts, firefox: ts}, stamped whenever the extension talks to this
# host (its boot ping "seen", refreshed by marketplace presence
# heartbeats, so extension builds predating the ping also leave evidence).
# The native messaging connection itself proves the install for that
# browser family, and entries are never pruned: an old timestamp only
# means the browser has not run since, not that the extension is gone.
# The bar widget reads this to decide whether a bar-icon left click
# should open the browser-extension install prompt (see BarWatch.qml).
SEEN_FILE="$STATE_DIR/browser-extension-seen.json"
SEEN_LOCK_FILE="$STATE_DIR/browser-extension-seen.lock"
# Update-detection cache: {checked, plugins:[{id,name,installedVersion,
# latestVersion,verified}]} for every plugin whose git HEAD is behind origin
# (all checks are cheap file reads for the extension; the git work runs in a
# detached refresher). settings.json is the bar widget's file (shared):
# {pollMinutes, allowUnverified}.
UPDATE_CACHE_FILE="$STATE_DIR/update-cache.json"
UPDATE_LOCK_FILE="$STATE_DIR/update-cache.lock"
SETTINGS_FILE="$STATE_DIR/settings.json"
UPDATE_TTL_SECONDS=300
# After an action is summoned (install/uninstall/update/toggle) the wizard
# does the git work over the next seconds, so the behind-set is rechecked in
# a fast window instead of waiting out the 5-minute TTL.
UPDATE_ACTION_STAMP="$STATE_DIR/update-action.stamp"
UPDATE_FAST_TTL_SECONDS=5
UPDATE_FAST_WINDOW_SECONDS=120

# Owner-only state storage, established before anything is written: the
# directory becomes 700 and every entry in it loses group/other access,
# including state files created by older releases under a 022 umask. Files
# created from now on are owner-only at creation through the process umask.
ensure_private_state() {
  mkdir -p "$STATE_DIR" || return 1
  chmod 700 "$STATE_DIR" 2>/dev/null || true
  # Only prune orphaned temp files older than 2 minutes so a concurrent
  # writer's active atomic staging file is never deleted out from under it.
  find "$STATE_DIR" -maxdepth 1 \( -name '*.tmp.*' -o -name '.*.tmp' \) -mmin +2 -delete 2>/dev/null || true
  local entry
  shopt -s nullglob
  for entry in "$STATE_DIR"/* "$STATE_DIR"/.[!.]* "$STATE_DIR"/..?*; do
    [[ -e $entry || -L $entry ]] || continue
    # Dirs keep owner rwx (700): traversable by the owner, closed to everyone
    # else; files keep their owner bits (600 for the ones written here).
    chmod go-rwx "$entry" 2>/dev/null || true
  done
  shopt -u nullglob
  return 0
}

byte_length() {
  local LC_ALL=C
  printf '%s' "${#1}"
}

send_frame() {
  local LC_ALL=C payload="$1"
  local len=${#payload} h0 h1 h2 h3
  printf -v h0 "%02x" $(( len & 0xff ))
  printf -v h1 "%02x" $(( (len >> 8) & 0xff ))
  printf -v h2 "%02x" $(( (len >> 16) & 0xff ))
  printf -v h3 "%02x" $(( (len >> 24) & 0xff ))
  printf "\\x$h0\\x$h1\\x$h2\\x$h3%s" "$payload"
}

reply() { send_frame "$(jq -cn "$@")"; }

reply_ok() { send_frame '{"ok":true}'; }

reply_err() {
  local reason="${1:-error}"
  reply --arg reason "$reason" '{ok:false, reason:$reason}'
}

# Is this plugin installed as a user (non-first-party) plugin? Prints
# {id, installed, enabled, firstParty} as compact JSON. Always succeeds
# with valid JSON. The id rides the output so the status handler's
# update-merge can match cache entries without re-binding it in argv.
plugin_status() {
  local id="$1" raw out default=""
  if [[ ! $id =~ ^[a-z0-9][a-z0-9.-]{0,127}$ || $id == *..* ]]; then
    printf '%s\n' '{"id":"","installed":false,"enabled":false,"firstParty":false,"barWidget":false}'
    return 0
  fi
  # The id passed the charset regex above (no quotes, backslashes, or
  # control characters), so embedding it in JSON is safe.
  default="{\"id\":\"$id\",\"installed\":false,\"enabled\":false,\"firstParty\":false,\"barWidget\":false}"
  raw=$(omarchy plugin list --json 2>/dev/null) || raw="[]"
  [[ -n $raw ]] || raw="[]"
  # The viewed marketplace page polls this every second, so the requested
  # id is browsing activity: pass the id and the plugin list in one stdin
  # payload and do the matching inside jq. The id never appears in jq's
  # argv, where every local account could read it through /proc and see
  # which marketplace plugin page is being viewed.
  out=$(jq -c '
    . as $in
    | ($in.plugins | if type == "array" then . else [] end)
    | map(select(type == "object" and .id == $in.want))
    | if length > 0 then .[0]
      | {id: $in.want,
         installed: ((.firstParty // false) | not),
         enabled: (.enabled == true),
         firstParty: (.firstParty == true),
         barWidget: (((.kinds // []) | index("bar-widget")) != null)}
      else $in.fallback
      end
  ' <<<"{\"want\":\"$id\",\"plugins\":$raw,\"fallback\":$default}" 2>/dev/null) || out=""
  [[ -n $out ]] || out="$default"
  printf '%s\n' "$out"
}

# The bar widget's "Update to unverified version" toggle (settings.json in
# the state dir, written by BarWatch.qml). Prints "true" or "false"; a
# missing or corrupt file means the default: verified-only.
allow_unverified_setting() {
  local content=""
  if [[ -r "$SETTINGS_FILE" ]]; then
    content=$(<"$SETTINGS_FILE") || content=""
  fi
  if [[ $content =~ \"allowUnverified\"[[:space:]]*:[[:space:]]*true ]]; then
    printf 'true'
  else
    printf 'false'
  fi
}

# Age of the update cache in seconds (huge when absent/corrupt → refresh).
update_cache_age() {
  local content="" ts=0 now=0
  if [[ -r "$UPDATE_CACHE_FILE" ]]; then
    content=$(<"$UPDATE_CACHE_FILE") || content=""
  fi
  if [[ $content =~ \"checked\"[[:space:]]*:[[:space:]]*([0-9]{1,12}) ]]; then
    ts="10#${BASH_REMATCH[1]}"
  fi
  now=${EPOCHSECONDS:-$(date +%s)}
  printf '%s' "$(( now - ts ))"
}

# Refresh the behind-set cache by running the shared detector
# (bin/omarchy-plugin-update check) — one implementation for the bar
# widget, the wizard, and this host, so the three can never disagree about
# which plugin is behind or which commit a verified update may load. The
# detector prints {"ok":true,"plugins":[{id,name,installed,latest,remote,
# verified,...}]} in the same git-ancestry model the CLI uses (a plugin is
# behind when its HEAD is a strict ancestor of origin's freshly fetched
# HEAD; symlinks, dirty trees, detached HEADs, and clones without an
# origin are skipped; verified only when the fetched tip IS the catalog's
# verificationCommit). The cache keeps the installedVersion/latestVersion
# alias spelling the extension's status schema expects. A failed run
# (catalog unreachable, offline) keeps the last-good cache: an offline
# host never invents an update.
run_update_check() {
  local res="" plugins="" ts="" tmp=""
  res=$(bash "$HOST_DIR/omarchy-plugin-update" check 2>/dev/null) || res=""
  jq -e 'type == "object" and .ok == true and (.plugins | type == "array")' <<<"$res" >/dev/null 2>&1 || return 0
  plugins=$(jq -c '[.plugins[] | select(type == "object") | .
      + {installedVersion: (.installed // ""), latestVersion: (.latest // "")}]' <<<"$res" 2>/dev/null) || plugins="[]"
  [[ ${plugins:0:1} == "[" ]] || plugins="[]"
  ts=$(date +%s)
  ensure_private_state || return 0
  tmp="$UPDATE_CACHE_FILE.tmp.$$"
  if jq -cn --argjson ts "$ts" --argjson plugins "$plugins" \
    '{checked:$ts, plugins:$plugins}' >"$tmp" 2>/dev/null; then
    mv -f "$tmp" "$UPDATE_CACHE_FILE" || rm -f "$tmp"
  else
    rm -f "$tmp"
  fi
  return 0
}

# Effective cache TTL: the normal 5 minutes, shortened to a few seconds for
# two minutes after an action was summoned (the wizard is doing git work in
# the background right then). The stamp cleans itself up when the window ends.
effective_update_ttl() {
  local now mtime
  [[ -e $UPDATE_ACTION_STAMP ]] || { printf '%s' "$UPDATE_TTL_SECONDS"; return 0; }
  now=${EPOCHSECONDS:-$(date +%s)}
  mtime=$(stat -c %Y "$UPDATE_ACTION_STAMP" 2>/dev/null) || mtime=0
  if (( now - mtime < UPDATE_FAST_WINDOW_SECONDS )); then
    printf '%s' "$UPDATE_FAST_TTL_SECONDS"
  else
    rm -f "$UPDATE_ACTION_STAMP" 2>/dev/null || true
    printf '%s' "$UPDATE_TTL_SECONDS"
  fi
}

# Kick a detached refresh when the cache is stale. The non-blocking flock
# keeps concurrent polls to a single refresher (status polls arrive every
# second); the child must never inherit the native-messaging stdin/stdout.
maybe_refresh_updates() {
  (( $(update_cache_age) < $(effective_update_ttl) )) && return 0
  mkdir -p "$STATE_DIR" 2>/dev/null || return 0
  (
    exec 9>"$UPDATE_LOCK_FILE" 2>/dev/null || exit 0
    flock -n 9 || exit 0
    run_update_check
  ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
  return 0
}

# Cached behind-set as compact JSON array (all entries are behind; the
# verification gate is applied by the caller/merges).
cached_update_plugins() {
  local out
  out=$(jq -c '.plugins // []' "$UPDATE_CACHE_FILE" 2>/dev/null) || out="[]"
  [[ ${out:0:1} == "[" ]] || out="[]"
  printf '%s\n' "$out"
}

# Merge cached update info into one status object (or an array of them).
# With allowUnverified off, unverified updates are hidden entirely: the
# extension never learns the plugin is behind, exactly like the bar badge.
merge_updates_into() {
  local json="$1" allow="$2" cache="$3"
  local out
  out=$(jq -c --argjson allow "$allow" --argjson cache "$cache" '
    def decorate($u):
      . + (if $u != null and ($allow or ($u.verified == true)) then
             {updateAvailable: true,
              installedVersion: ($u.installedVersion // ""),
              latestVersion: ($u.latestVersion // ""),
              verified: ($u.verified == true)}
           else {updateAvailable: false} end);
    if type == "array" then
      map(. as $p
        | ($cache | map(select(type == "object" and .id == $p.id)) | first) as $u
        | decorate($u))
    else
      . as $s
      | ($cache | map(select(type == "object" and .id == ($s.id // ""))) | first) as $u
      | decorate($u)
    end
  ' <<<"$json" 2>/dev/null) || out="$json"
  [[ -n $out ]] || out="$json"
  printf '%s\n' "$out"
}

# Parse id/repo out of a payload and normalize them. Sets _target_id and
# _target_repo; prints a machine-readable reason and returns 1 on failure.
normalize_target() {
  local payload="$1" id="" repo="" owner="" repo_name=""

  IFS=$'\t' read -r id repo < <(
    jq -r '[
      (if type == "object" and (.id | type) == "string" then .id else "" end),
      (if type == "object" and (.repo | type) == "string" then .repo else "" end)
    ] | @tsv' <<<"$payload" 2>/dev/null || echo ""
  )

  [[ $id =~ ^[a-z0-9][a-z0-9.-]{0,127}$ && $id != *..* ]] || {
    echo "invalid-plugin-id"
    return 1
  }
  if [[ ! $repo =~ ^https://github\.com/([A-Za-z0-9._-]+)/([A-Za-z0-9._-]+)(\.git)?/?$ ]]; then
    echo "invalid-repo-url"
    return 1
  fi
  owner="${BASH_REMATCH[1]}"
  repo_name="${BASH_REMATCH[2]%.git}"
  if [[ $owner == "." || $owner == ".." || $repo_name == "." || $repo_name == ".." || -z $repo_name ]]; then
    echo "invalid-repo-url"
    return 1
  fi
  _target_id="$id"
  _target_repo="https://github.com/$owner/$repo_name"
  return 0
}

# Validate an install/uninstall/enable/disable request against local state and
# a fresh fetch of the marketplace catalog. Prints a machine-readable reason on
# failure and returns 1; returns 0 when trustworthy enough to summon the wizard.
validate_action() {
  local payload="$1" mode="$2"
  local id="" repo="" status="" catalog="" catalog_check=""

  # normalize_target echoes the machine-readable reason itself, which is
  # exactly what this function's caller captures on failure.
  normalize_target "$payload" || return 1
  id="$_target_id"
  repo="$_target_repo"

  # Check local plugin status first before making a network request.
  status=$(plugin_status "$id")

  # Bar-section placement is layout config, not an install: it validates
  # against local state only (no catalog round-trip), so the marketplace
  # Position button keeps working when the catalog is unreachable.
  if [[ $mode == "placement" ]]; then
    jq -e '.installed == true' >/dev/null <<<"$status" || {
      echo "not-installed"
      return 1
    }
    jq -e '.barWidget == true' >/dev/null <<<"$status" || {
      echo "not-a-bar-widget"
      return 1
    }
    return 0
  fi

  case "$mode" in
    install)
      jq -e '.installed == false and .firstParty == false' >/dev/null <<<"$status" || {
        echo "already-installed"
        return 1
      }
      ;;
    uninstall)
      jq -e '.installed == true' >/dev/null <<<"$status" || {
        echo "not-installed"
        return 1
      }
      ;;
    update)
      jq -e '.installed == true' >/dev/null <<<"$status" || {
        echo "not-installed"
        return 1
      }
      ;;
    enable)
      jq -e '.installed == true' >/dev/null <<<"$status" || {
        echo "not-installed"
        return 1
      }
      jq -e '.enabled == false' >/dev/null <<<"$status" || {
        echo "already-enabled"
        return 1
      }
      ;;
    disable)
      jq -e '.installed == true' >/dev/null <<<"$status" || {
        echo "not-installed"
        return 1
      }
      jq -e '.enabled == true' >/dev/null <<<"$status" || {
        echo "already-disabled"
        return 1
      }
      ;;
    *)
      echo "unknown-message-type"
      return 1
      ;;
  esac

  # --max-filesize mirrors the shared detector (omarchy-plugin-update check):
  # a hostile or broken CDN cannot feed an unbounded body into jq.
  catalog=$(curl -fsSL --proto '=https' --max-time 10 --max-filesize 16777216 "$CATALOG_URL" 2>/dev/null) || {
    echo "catalog-unreachable"
    return 1
  }

  catalog_check=$(jq -r --arg id "$id" --arg repo "$repo" --arg mode "$mode" '
    ((if type == "array" then . else (.plugins // []) end) | map(select(type == "object" and .id == $id)) | first) as $entry
    | if $entry == null then
        "unknown-plugin-id"
      elif (($entry.repo // "" | sub("/+$"; "") | sub("\\.git$"; "")) != $repo) then
        "repo-mismatch"
      elif $mode == "install" and (
        (($entry.installAvailable == true)
          and ($entry.upstreamCheckStatus != "failed")
          and (($entry.installCommand // "") | length > 0)
          and (($entry.builtIn // false) | not)) | not
      ) then
        "not-one-click-installable"
      else
        "ok"
      end
  ' <<<"$catalog" 2>/dev/null) || {
    echo "catalog-unreachable"
    return 1
  }

  [[ $catalog_check == "ok" ]] || {
    echo "${catalog_check:-catalog-unreachable}"
    return 1
  }

  return 0
}

summon_wizard() {
  local payload="$1" mode="$2" json
  json=$(jq -c --arg mode "$mode" '{
    source: "browser",
    mode: $mode,
    id: (if (.id | type) == "string" then .id else "" end),
    repo: (if (.repo | type) == "string" then .repo else "" end),
    name: (if (.name | type) == "string" then (.name | gsub("[\\u0000-\\u001f\\u007f]"; "") | .[0:128]) else "" end)
  }' <<<"$payload" 2>/dev/null) || return 1
  omarchy-shell shell summon "$WIZARD_ID" "$json" >/dev/null 2>&1
}

# The bar layout file's section that currently holds a plugin's icon
# ("" when unknown): the same $XDG_CONFIG_HOME/omarchy/shell.json the bar
# widget reads for its placement UI, so the placement dialog opens with
# the plugin's real section marked "(current)". The id is re-extracted
# from the extension payload here, so it is grammar-checked before it
# ever keys anything.
current_bar_section() {
  local id="$1" file="" out=""
  [[ $id =~ ^[a-z0-9][a-z0-9.-]{0,127}$ && $id != *..* ]] || return 0
  file="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
  [[ -f $file ]] || return 0
  out=$(head -c 262144 "$file" 2>/dev/null | jq -r --arg id "$id" '
    (.bar.layout // {}) as $lay
    | ["left","centerBegin","center","centerEnd","right","tray"][] as $s
    | select((($lay[$s] // []) | if type == "array" then . else [] end)
             | any(.[]?; type == "object" and ((.id // "") == $id)))
    | $s
  ' 2>/dev/null | head -n1)
  # Whitelist the answer: only a known section name ever reaches the
  # summon payload.
  [[ $out =~ ^(left|centerBegin|center|centerEnd|right|tray)$ ]] || out=""
  printf '%s\n' "$out"
}

# Placement shortcut from the marketplace page: same settings channel the
# bar popup's Position button uses (mode "settings" plus the placement
# stage), so the already-open placement dialog lands on top of the live
# settings panel and Escape/Close return to it.
summon_placement() {
  local payload="$1" json id="" section=""
  id=$(jq -r 'if type == "object" and (.id | type) == "string" then .id else "" end' <<<"$payload" 2>/dev/null || true)
  section=$(current_bar_section "${id:-}")
  json=$(jq -c --arg stage "placement" --arg section "$section" '{
    source: "browser",
    mode: "settings",
    stage: $stage,
    section: $section,
    id: (if (.id | type) == "string" then .id else "" end),
    repo: (if (.repo | type) == "string" then .repo else "" end),
    name: (if (.name | type) == "string" then (.name | gsub("[\\u0000-\\u001f\\u007f]"; "") | .[0:128]) else "" end)
  }' <<<"$payload" 2>/dev/null) || return 1
  omarchy-shell shell summon "$WIZARD_ID" "$json" >/dev/null 2>&1
}

# Bar-icon watcher beacon: record the plugin page of the tab that sent the
# "watch". Format-checked only (id/repo shape): the beacon never acts, it
# only lights the bar icon. Every action from the dropdown is re-validated
# through validate_action and confirmed by the wizard. The record carries
# this host's pid so only the owner clears it. A live beacon renews ts;
# "paused":true (the tab's window lost OS focus) stamps the existing record
# of that same plugin paused so the bar widget dims within its poll, and
# the next live "watch" (focus regained) lights it again; a beacon that
# stops without pausing (browser killed) goes stale and the icon dims.
record_watch() {
  local payload="$1" ts="" tmp="" json="" paused="false"
  normalize_target "$payload" || return 1
  paused=$(jq -r 'if type == "object" and (.paused == true) then "true" else "false" end' <<<"$payload" 2>/dev/null) || paused="false"
  ts=${EPOCHSECONDS:-$(date +%s)}
  ensure_private_state || return 1
  (
    exec 7>"$WATCH_LOCK_FILE" 2>/dev/null || exit 1
    flock -x 7 || exit 1
    if [[ $paused == "true" ]]; then
      # Id-scoped pause (same rule as clear_watch_for_id): a late blur write
      # from the tab that was switched away from must never pause the new
      # tab's live record, and a pause must never create a record.
      [[ -f $WATCH_FILE ]] || exit 0
      [[ "$(jq -r '.id // empty' "$WATCH_FILE" 2>/dev/null)" == "$_target_id" ]] || exit 0
      json=$(jq -c --argjson pid "$$" --argjson ts "$ts" \
        '. + {paused:true, pid:$pid, ts:$ts}' "$WATCH_FILE" 2>/dev/null) || exit 1
    else
      # The viewed plugin's id/repo/name are browsing activity: assemble the
      # record in one jq pass over stdin (the payload), never in argv, which
      # every local account can read through /proc. Only numbers (pid, ts)
      # and the filter itself are arguments. The id/repo checks re-implement
      # normalize_target's shape rules; reaching here with a payload that
      # passes normalize_target yields a record, anything else exits 1.
      json=$(jq -c --argjson pid "$$" --argjson ts "$ts" '
        select(type == "object")
        | (if (.id | type) == "string" then .id else "" end) as $id
        | (if (.repo | type) == "string" then .repo else "" end) as $repo
        | ($repo | capture("^https://github\\.com/(?<owner>[A-Za-z0-9._-]+)/(?<repo_name>[A-Za-z0-9._-]+)(\\.git)?/?$")) as $m
        | select($m != null
            and ($id | test("^[a-z0-9][a-z0-9.-]{0,127}$"))
            and ($id | contains("..") | not)
            and $m.owner != "." and $m.owner != ".."
            and $m.repo_name != "." and $m.repo_name != "..")
        | {id: $id,
           repo: ("https://github.com/" + $m.owner + "/" + ($m.repo_name | sub("\\.git$"; ""))),
           name: (if (.name | type) == "string" then (.name | gsub("[\\u0000-\\u001f\\u007f]"; "") | .[0:128]) else "" end),
           pid: $pid, ts: $ts}
      ' <<<"$payload" 2>/dev/null) || exit 1
      [[ -n $json ]] || exit 1
    fi
    tmp="$WATCH_FILE.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$json" >"$tmp" && mv -f "$tmp" "$WATCH_FILE"
  )
}

# Remove the beacon record, but only when this host process wrote it: a
# second running browser has its own host keeping its own beacon fresh.
clear_watch() {
  [[ -f $WATCH_FILE ]] || return 0
  (
    exec 7>"$WATCH_LOCK_FILE" 2>/dev/null || exit 0
    flock -x 7 || exit 0
    [[ -f $WATCH_FILE ]] || exit 0
    [[ "$(jq -r '.pid // empty' "$WATCH_FILE" 2>/dev/null)" == "$$" ]] && rm -f "$WATCH_FILE"
  )
  return 0
}

# Id-scoped unwatch: a tab leaving removes the record only when it is the
# tab's own plugin. Rapid tab switches deliver the previous tab's unwatch
# after the new tab's watch (new pages boot slower than visibility events
# lag); without the id guard that late unwatch wipes the new plugin's
# record and the bar panel/icon goes stale until the next renewal.
clear_watch_for_id() {
  local id="$1"
  [[ -n $id && -f $WATCH_FILE ]] || return 0
  (
    exec 7>"$WATCH_LOCK_FILE" 2>/dev/null || exit 0
    flock -x 7 || exit 0
    [[ -f $WATCH_FILE ]] || exit 0
    [[ "$(jq -r '.id // empty' "$WATCH_FILE" 2>/dev/null)" == "$id" ]] || exit 0
    [[ "$(jq -r '.pid // empty' "$WATCH_FILE" 2>/dev/null)" == "$$" ]] && rm -f "$WATCH_FILE"
  )
  return 0
}

# Presence heartbeat record: one entry per open marketplace tab, keyed by
# the tab's per-load random key. Entries older than the freshness window
# are pruned on every write (a killed browser's tab simply ages out).
# Echoes "activate" when this visit consumes a pending bar-widget focus
# request, so the dispatch answers activate:true and the extension raises
# the tab.
record_visit() {
  local payload="$1" entry="" key="" state="" ts="" tmp="" merged="" en_in=""
  ts=${EPOCHSECONDS:-$(date +%s)}
  # The heartbeat fields are validated, truncated, and assembled in a single
  # jq pass over stdin: the marketplace URL is browsing activity, so it must
  # never appear in a process argument (every local account can read argv
  # through /proc).
  entry=$(jq -c --argjson ts "$ts" '
    select(type == "object")
    | (if (.key | type) == "string" then .key[0:64] else "" end) as $key
    | (if (.url | type) == "string" then .url[0:512] else "" end) as $url
    | select($key != "" and $url != "")
    | {source: (if (.source | type) == "string" then .source[0:32] else "" end),
       key: $key, url: $url, ts: $ts,
       active: (if (.active | type) == "boolean" then .active else false end)}
  ' <<<"$payload" 2>/dev/null) || entry=""
  [[ ${entry:0:1} == "{" ]] || return 1
  key=$(jq -r '.key // ""' <<<"$entry" 2>/dev/null) || key=""
  [[ -n $key ]] || return 1
  ensure_private_state || return 1
  (
    exec 8>"$TABS_LOCK_FILE" 2>/dev/null || exit 1
    flock -x 8 || exit 1
    state=$(cat "$TABS_FILE" 2>/dev/null) || state=""
    [[ ${state:0:1} == "{" ]] || state='{}'
    # Neither input travels through argv (no printf/process-substitution of
    # the content: that would show the URL in /proc): the previous state
    # arrives on stdin (here-string), the new record through a mode-0600
    # temp file handed to jq as --slurpfile (only the path is an argument).
    # The merge de-duplicates by source+key and prunes to the freshness
    # window.
    en_in="$STATE_DIR/.tabs-entry.$$.tmp"
    tmp="$TABS_FILE.tmp.$$"
    trap 'rm -f "$en_in" "$tmp"' EXIT
    cat >"$en_in" <<<"$entry" || exit 1
    merged=$(jq -cs --argjson fresh "$((ts - 30))" --slurpfile e "$en_in" '
      (.[0] // {} | if type == "object" then . else {} end) as $state
      | ($e[0] // {}) as $entry
      | {tabs: ([$entry] + ($state.tabs // [] | if type == "array" then . else [] end)
          | map(select(type == "object"))
          | unique_by((.source // "") + "|" + (.key // ""))
          | map(select((.ts | if type == "number" then . else 0 end) >= $fresh)))}
    ' <<<"$state" 2>/dev/null)
    [[ ${merged:0:1} == "{" ]] || exit 1
    printf '%s\n' "$merged" >"$tmp" && mv -f "$tmp" "$TABS_FILE"
  ) || return 1
  drain_focus_request "$key"
}

# Remove a tab's presence record (page closed / navigated away).
clear_visit() {
  local payload="$1" key="" tmp="" json=""
  key=$(jq -r 'if type == "object" and (.key | type) == "string" then .key[0:64] else "" end' <<<"$payload" 2>/dev/null) || key=""
  [[ -n $key && -f $TABS_FILE ]] || return 0
  ensure_private_state || return 0
  (
    exec 8>"$TABS_LOCK_FILE" 2>/dev/null || exit 0
    flock -x 8 || exit 0
    [[ -f $TABS_FILE ]] || exit 0
    json=$(jq -c --arg key "$key" '{tabs: ((.tabs // []) | map(select(.key != $key)))}' "$TABS_FILE" 2>/dev/null) || exit 0
    tmp="$TABS_FILE.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$json" >"$tmp" && mv -f "$tmp" "$TABS_FILE"
  )
  return 0
}

# Stamp install evidence for one browser family ("chrome" | "firefox"):
# the fact that this host process was launched and received a message from
# the extension means that family has the extension installed. Cheap by
# design: a family stamped within the last hour is not rewritten (the
# presence heartbeat fires every couple of seconds per open tab), and a
# corrupt or missing file is simply re-initialized.
stamp_seen() {
  local src="$1" ts="" json="" tmp=""
  [[ $src == "chrome" || $src == "firefox" ]] || return 0
  ts=${EPOCHSECONDS:-$(date +%s)}
  json=$(cat "$SEEN_FILE" 2>/dev/null) || json=""
  [[ ${json:0:1} == "{" ]] || json='{}'
  # Type-guarded compare: jq orders strings above numbers, so a corrupt
  # non-numeric entry would otherwise read as "fresh forever" and lock the
  # family out of ever being (re)stamped.
  if jq -e --arg s "$src" --argjson fresh "$((ts - 3600))" \
      '(.[$s] | if type == "number" then . else 0 end) >= $fresh' <<<"$json" >/dev/null 2>&1; then
    return 0
  fi
  ensure_private_state || return 0
  (
    exec 8>"$SEEN_LOCK_FILE" 2>/dev/null || exit 0
    flock -x 8 || exit 0
    json=$(cat "$SEEN_FILE" 2>/dev/null) || json='{}'
    [[ ${json:0:1} == "{" ]] || json='{}'
    json=$(jq -c --arg s "$src" --argjson ts "$ts" \
      '(. + {($s): $ts}) | with_entries(select(.key == "chrome" or .key == "firefox"))' \
      <<<"$json" 2>/dev/null)
    [[ ${json:0:1} == "{" ]] || exit 0
    tmp="$SEEN_FILE.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$json" >"$tmp" && mv -f "$tmp" "$SEEN_FILE"
  )
  return 0
}

# Consume a pending focus request from the bar widget: the request is live
# for a few seconds (the widget suppresses its popup meanwhile) and is
# answered by exactly one visiting tab. The widget stamps ts in Unix
# milliseconds (Date.now), so the staleness math runs in ms too. Echoes
# "activate" when consumed.
drain_focus_request() {
  local key="$1" ts="" now="" tmp="" json=""
  [[ -f $FOCUS_FILE ]] || return 0
  (
    exec 9>"$FOCUS_FILE.lock" 2>/dev/null || exit 0
    flock -x 9 || exit 0
    [[ -f $FOCUS_FILE ]] || exit 0
    ts=$(jq -r 'if type == "object" and (.ts | type) == "number" and .ts >= 0 then (.ts | floor) else 0 end' "$FOCUS_FILE" 2>/dev/null) || ts=0
    [[ $ts =~ ^[0-9]{1,16}$ ]] || ts=0
    now=$(( ${EPOCHSECONDS:-$(date +%s)} * 1000 ))
    if (( now - ts > 8000 )); then
      # Nobody answered in time (no live tab): drop it, the widget cleans up
      # its own state on timeout.
      rm -f "$FOCUS_FILE" 2>/dev/null || true
      exit 0
    fi
    json=$(jq -e --arg by "$key" '
      if (.consumedBy // "") == "" then . + {consumedBy: $by} else error("already-consumed") end
    ' "$FOCUS_FILE" 2>/dev/null) || exit 0
    tmp="$FOCUS_FILE.tmp.$$"
    trap 'rm -f "$tmp"' EXIT
    printf '%s\n' "$json" >"$tmp" && mv -f "$tmp" "$FOCUS_FILE" && echo activate
  )
}

main() {
  local length payload type id local_status all_status reason activated trace
  # Message trace: opt-in diagnostic (enable with PI_NATIVE_TRACE=<path>,
  # one line per received frame) for debugging beacon traffic. Off by
  # default: the shell and browsers run this host constantly.
  trace="${PI_NATIVE_TRACE-}"
  if [[ -n $trace && -f $trace ]] && (( $(stat -c%s "$trace" 2>/dev/null || echo 0) > 200000 )); then
    : > "$trace"   # truncate on launch instead of growing forever
  fi
  on_host_exit() {
    local rc=$?
    clear_watch
    if [[ -n $trace ]]; then
      printf '%s exit pid=%s rc=%s\n' "$(date +%T)" "$$" "$rc" >> "$trace" 2>/dev/null || true
    fi
  }
  trap on_host_exit EXIT
  if [[ -n $trace ]] && mkdir -p "$(dirname -- "$trace")" 2>/dev/null; then
    printf '%s launch pid=%s argv=%s\n' "$(date +%T)" "$$" "$*" >> "$trace" 2>/dev/null || true
  else
    trace=""
  fi

  # Tighten the state dir and pre-existing state files (older releases wrote
  # them world-readable) before any read or write of the browsing records.
  ensure_private_state 2>/dev/null || true

  while :; do
    length=$(head -c4 | od -An -v -tu4 --endian=little | tr -d ' \n')
    [[ -n ${length:-} ]] && (( length > 0 && length <= MAX_FRAME_BYTES )) || exit 0
    # Command substitution strips trailing newlines; Firefox appends one to
    # every frame. The sentinel keeps the payload bytes exact so the
    # byte-length check below compares against the real frame.
    payload=$(head -c "$length"; printf x)
    payload=${payload%x}
    (( $(byte_length "$payload") == length )) || exit 0

    type=$(jq -r 'if type == "object" and (.type | type) == "string" then .type else "" end' <<<"$payload" 2>/dev/null || true)
    if [[ -n $trace ]]; then
      printf '%s recv pid=%s bytes=%s type=%s\n' "$(date +%T)" "$$" "$length" "${type:-?}" >> "$trace" 2>/dev/null || true
    fi

    case "$type" in
      ping)
        send_frame "{\"ok\":true,\"host\":\"$HOST_NAME\",\"version\":\"$HOST_VERSION\"}"
        ;;
      status)
        id=$(jq -r 'if type == "object" and (.id | type) == "string" then .id else "" end' <<<"$payload" 2>/dev/null || true)
        local_status=$(plugin_status "$id")
        maybe_refresh_updates
        # plugin_status's output carries the requested id (assembled on
        # stdin, never in argv) so the update-info merge can match the
        # cache entry.
        local_status=$(merge_updates_into "$local_status" "$(allow_unverified_setting)" "$(cached_update_plugins)")
        # Merge ok with jq instead of string surgery: a malformed
        # upstream payload can only ever produce an explicit failure
        # frame, never a malformed one. Consumers all gate on .ok.
        if jq -e 'type == "object"' <<<"$local_status" >/dev/null 2>&1; then
          send_frame "$(jq -c '. + {ok: true}' <<<"$local_status")"
        else
          send_frame '{"ok":false,"error":"status-malformed"}'
        fi
        ;;
      status_all)
        # Batch report for the catalog page: every installed user (non
        # first-party) plugin in one call, decorated with the cached
        # update info (verification setting applied). Plugins missing
        # from the list are not installed.
        all_status=$(omarchy plugin list --json 2>/dev/null | jq -c \
          '[ (if type == "array" then . else [] end)[] | select(type == "object" and ((.firstParty // false) | not)) | {id: .id, installed: true, enabled: (.enabled == true), barWidget: (((.kinds // []) | index("bar-widget")) != null)} ]' \
          2>/dev/null) || all_status="[]"
        [[ ${all_status:-} == "["* ]] || all_status="[]"
        maybe_refresh_updates
        all_status=$(merge_updates_into "$all_status" "$(allow_unverified_setting)" "$(cached_update_plugins)")
        # Same jq merge as the status handler above: a merge that fell back
        # to raw text can only ever produce an explicit failure frame here,
        # never a malformed one built by string surgery.
        if jq -e 'type == "array"' <<<"$all_status" >/dev/null 2>&1; then
          send_frame "$(jq -c '{ok: true, plugins: .}' <<<"$all_status")"
        else
          send_frame '{"ok":false,"error":"status-malformed"}'
        fi
        ;;
      updates)
        # The behind-set for the extension's update UI: the cached
        # git-ancestry check, gate applied (unverified entries dropped
        # when the setting is off). A stale cache answers immediately and
        # kicks the detached refresher; the next poll sees fresh data.
        maybe_refresh_updates
        local_status=$(jq -cn --argjson allow "$(allow_unverified_setting)" \
          --argjson plugins "$(cached_update_plugins)" \
          '{ok:true, plugins: ($plugins | map(select($allow or (.verified == true))))}' 2>/dev/null) \
          || local_status='{"ok":true,"plugins":[]}'
        send_frame "$local_status"
        ;;
      placement)
        # Position button on the marketplace page: open the placement
        # dialog for an installed bar widget (local validation only).
        if reason=$(validate_action "$payload" "$type"); then
          if summon_placement "$payload"; then
            reply_ok
          else
            reply_err "wizard-not-available (is bramvanoploo.omarchy-browser-plugin-manager enabled in the shell?)"
          fi
        else
          reply_err "$reason"
        fi
        ;;
      install|uninstall|enable|disable|update)
        if reason=$(validate_action "$payload" "$type"); then
          if summon_wizard "$payload" "$type"; then
            # The wizard will mutate the plugin clone: drop the cache and
            # enter the fast recheck window so the badge follows within
            # seconds of the wizard finishing.
            rm -f "$UPDATE_CACHE_FILE" 2>/dev/null || true
            touch "$UPDATE_ACTION_STAMP" 2>/dev/null || true
            reply_ok
          else
            reply_err "wizard-not-available (is bramvanoploo.omarchy-browser-plugin-manager enabled in the shell?)"
          fi
        else
          reply_err "$reason"
        fi
        ;;
      watch)
        if reason=$(record_watch "$payload"); then
          reply_ok
        else
          reply_err "$reason"
        fi
        ;;
      unwatch)
        id=$(jq -r 'if type == "object" and (.id | type) == "string" then .id else "" end' <<<"$payload" 2>/dev/null || true)
        clear_watch_for_id "$id"
        reply_ok
        ;;
      visit)
        # Presence heartbeat; record_visit echoes "activate" when this tab
        # must raise itself (the bar widget asked for the marketplace tab).
        # The assignment sits in the if so a failing record does not trip
        # set -e.
        if activated=$(record_visit "$payload"); then
          # A heartbeat also proves the family's install: extension builds
          # without the boot ping still leave evidence through here.
          src=$(jq -r 'if type == "object" and (.source | type) == "string" then .source else "" end' <<<"$payload" 2>/dev/null || true)
          stamp_seen "$src"
          if [[ $activated == "activate" ]]; then
            send_frame '{"ok":true,"activate":true}'
          else
            reply_ok
          fi
        else
          reply_err "invalid-visit"
        fi
        ;;
      seen)
        # Boot ping: the extension announces itself as soon as its service
        # worker starts (browser start, install, update), independent of any
        # open marketplace tab. The connection proves the install.
        src=$(jq -r 'if type == "object" and (.source | type) == "string" then .source else "" end' <<<"$payload" 2>/dev/null || true)
        stamp_seen "$src"
        reply_ok
        ;;
      unvisit)
        clear_visit "$payload"
        reply_ok
        ;;
      *)
        reply_err "unknown-message-type"
        ;;
    esac
  done
}

if [[ ${BASH_SOURCE[0]} == "$0" ]]; then
  main "$@"
fi
