#!/bin/bash
# Signs the Firefox add-on with AMO "unlisted" signing so release builds of
# Firefox accept it as a permanent install (about:addons -> Install Add-on
# From File). Unlisted signing is not a store listing: the signed .xpi can be
# distributed from any download link.
#
# Prerequisites (free):
#   1. https://addons.mozilla.org/ -> developer account
#   2. https://addons.mozilla.org/developers/keys/ -> create API key+secret
#   3. web-ext:  npm install --global web-ext   (or: npm exec --yes --)
#
# Usage:
#   AMO_API_KEY=... AMO_API_SECRET=... bin/sign
#
# Output:
#   dist/signed/<slug>-<version>-signed.xpi  ("slug" = manifest name, as in
#   bin/package; AMO's own file is kept next to it)
# Its add-on ID stays bramvanoploo.omarchy-browser-plugin-manager@bram.dev (from manifest.json
# browser_specific_settings), which the native messaging host allowlists.

set -euo pipefail
export LC_ALL=C

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname -- "$SCRIPT_PATH")"
REPO_DIR="$(dirname -- "$BIN_DIR")"
EXT_DIR="$REPO_DIR/extension"
OUT_DIR="$REPO_DIR/dist/signed"

[[ -n "${AMO_API_KEY:-}" && -n "${AMO_API_SECRET:-}" ]] || {
  echo "Set AMO_API_KEY and AMO_API_SECRET (https://addons.mozilla.org/developers/keys/)." >&2
  exit 1
}

if command -v web-ext >/dev/null; then
  WEB_EXT=(web-ext)
elif command -v npm >/dev/null; then
  WEB_EXT=(npm exec --yes -- web-ext)
else
  echo "web-ext not found; install it with: npm install --global web-ext" >&2
  exit 1
fi

# Firefox AMO lint requires the MV2 "background.scripts" fallback next to
# "service_worker"; the shared source manifest omits it so Chrome stays
# warning-free. Sign a staged copy with the fallback injected (same trick as
# bin/package uses for the .xpi).
STAGE="$(mktemp -d)"
cleanup() {
  if [[ -f "$STAGE/extension/.amo-upload-uuid" ]]; then
    cp -f "$STAGE/extension/.amo-upload-uuid" "$EXT_DIR/.amo-upload-uuid" 2>/dev/null || true
  fi
  rm -rf "$STAGE"
}
trap cleanup EXIT

cp -r "$EXT_DIR" "$STAGE/extension"
jq '.background += {scripts: ["background.js"]}' "$STAGE/extension/manifest.json" > "$STAGE/extension/manifest.json.tmp" \
  && mv "$STAGE/extension/manifest.json.tmp" "$STAGE/extension/manifest.json"

mkdir -p "$STAGE/artifacts" "$OUT_DIR"
cd "$STAGE/extension"
"${WEB_EXT[@]}" sign \
  --channel=unlisted \
  --api-key="$AMO_API_KEY" \
  --api-secret="$AMO_API_SECRET" \
  --artifacts-dir "$STAGE/artifacts"

shopt -s nullglob
xpi_files=("$STAGE/artifacts"/*.xpi)
shopt -u nullglob
(( ${#xpi_files[@]} > 0 )) || { echo "signing produced no .xpi artifact" >&2; exit 1; }
signed="${xpi_files[0]}"

# Normalize the AMO filename to the canonical "<slug>-<version>-signed.xpi"
# (same slug derivation as bin/package).
VERSION="$(jq -r .version "$STAGE/extension/manifest.json")"
NAME="$(jq -r .name "$STAGE/extension/manifest.json" | tr '[:upper:]' '[:lower:]' \
  | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-\{1,\}//; s/-\{1,\}$//')"
canonical="$OUT_DIR/$NAME-$VERSION-signed.xpi"
amo_copy="$OUT_DIR/$(basename -- "$signed")"
cp -f -- "$signed" "$amo_copy"
cp -f -- "$signed" "$canonical"
echo "Signed add-on: $canonical (AMO copy: $amo_copy)"
echo "Install on release Firefox: about:addons -> gear -> Install Add-on From File"
