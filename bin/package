#!/bin/bash
# Builds downloadable, store-free browser-extension artifacts into dist/.
# Artifact names are always "<slug>-<version>[-suffix].*", where <slug> is
# derived from the extension manifest "name" (lowercased, non-alnum -> "-"),
# so names stay consistent with the plugin identity automatically.
#
#   dist/<slug>-<version>.xpi         Firefox add-on (permanent install on
#                                     ESR / Developer Edition / Nightly,
#                                     which allow unsigned add-ons).
#   dist/<slug>-<version>-listed.xpi  Firefox add-on for the AMO LISTED
#                                     submission: declares the listed add-on
#                                     ID omarchy-browser-plugin-manager@bram.dev
#                                     (the self-distribution ID is registered
#                                     on AMO via unlisted signing and rejected
#                                     for listed; @addons.mozilla.org IDs are
#                                     reserved; MV3 requires an explicit ID).
#   dist/<slug>-<version>-chrome.zip  Chrome Web Store / packed extension zip.
#   dist/<slug>-<version>-<date>.zip  Full source archive; the Chrome /
#                                     Chromium / Brave path (Load unpacked)
#                                     and the Firefox temporary-add-on path.

set -euo pipefail
export LC_ALL=C

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname -- "$SCRIPT_PATH")"
REPO_DIR="$(dirname -- "$BIN_DIR")"
EXT_DIR="$REPO_DIR/extension"
DIST_DIR="$REPO_DIR/dist"

VERSION="$(jq -r .version "$EXT_DIR/manifest.json")"
NAME="$(jq -r .name "$EXT_DIR/manifest.json" | tr '[:upper:]' '[:lower:]' \
  | sed 's/[^a-z0-9]\{1,\}/-/g; s/^-\{1,\}//; s/-\{1,\}$//')"
STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

mkdir -p "$DIST_DIR"
rm -f "$DIST_DIR/$NAME-$VERSION.xpi" \
      "$DIST_DIR/$NAME-$VERSION-listed.xpi" \
      "$DIST_DIR/$NAME-$VERSION-chrome.zip" \
      "$DIST_DIR/$NAME-$VERSION-"[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9].zip

# --- Firefox .xpi: zip of the extension/ contents at the archive root. ---
# Firefox's AMO lint REQUIRES the legacy MV2 "background.scripts" array, while
# Chrome requires "service_worker" and warns about the MV2 key. The shared
# source manifest keeps only "service_worker" (so Chrome and "Load unpacked"
# stay warning-free), and the Firefox artifacts REPLACE the background block
# with "scripts": Firefox ignores "service_worker" anyway, and keeping it
# beside "scripts" is what made AMO warn "service_worker is unsupported and
# ignored" (mirrors how the Chrome-only "key" is injected for chrome.zip).
mkdir -p "$STAGE/xpi"
cp -r "$EXT_DIR/." "$STAGE/xpi/"
rm -f "$STAGE/xpi/.amo-upload-uuid"
jq '.background = {scripts: ["background.js"]}' "$STAGE/xpi/manifest.json" > "$STAGE/xpi/manifest.json.tmp" \
  && mv "$STAGE/xpi/manifest.json.tmp" "$STAGE/xpi/manifest.json"
# manifest.json first, no extra zip fields: Firefox signing-service layout.
( cd "$STAGE/xpi" && \
  zip -qX "$DIST_DIR/$NAME-$VERSION.xpi" manifest.json && \
  zip -qrX "$DIST_DIR/$NAME-$VERSION.xpi" . -x manifest.json )

# --- Firefox AMO-LISTED upload: same scripts transform, LISTED add-on ID. ---
# AMO requires an explicit gecko.id for MV3 submissions, and the manifest's
# self-distribution ID is registered on AMO via unlisted signing, so listed
# submissions must use a fresh ID on our own domain ("@addons.mozilla.org"
# IDs are reserved for AMO). The native messaging host registers both IDs
# (see bin/plugin-installer-setup).
mkdir -p "$STAGE/listed"
cp -r "$EXT_DIR/." "$STAGE/listed/"
rm -f "$STAGE/listed/.amo-upload-uuid"
jq '.background = {scripts: ["background.js"]}
   | .browser_specific_settings.gecko.id = "omarchy-browser-plugin-manager@bram.dev"' \
   "$STAGE/listed/manifest.json" > "$STAGE/listed/manifest.json.tmp" \
  && mv "$STAGE/listed/manifest.json.tmp" "$STAGE/listed/manifest.json"
( cd "$STAGE/listed" && \
  zip -qX "$DIST_DIR/$NAME-$VERSION-listed.xpi" manifest.json && \
  zip -qrX "$DIST_DIR/$NAME-$VERSION-listed.xpi" . -x manifest.json )

# --- Chrome / Chromium / Brave zip: same root-level zip layout, the Chrome
# Web Store upload format. The Chrome-only "key" (stable extension ID) is
# injected HERE, not in the shared source manifest: Firefox warns about
# unknown manifest properties. "Load unpacked" uses the extension/ dir
# directly and gets the path-derived ID; setup registers both IDs.
mkdir -p "$STAGE/chrome"
cp -r "$EXT_DIR/." "$STAGE/chrome/"
rm -f "$STAGE/chrome/.amo-upload-uuid"
if [[ -f "$REPO_DIR/chrome-key.pem" ]]; then
  KEY_B64=$(openssl pkey -in "$REPO_DIR/chrome-key.pem" -pubout -outform DER 2>/dev/null | base64 -w0)
  jq --arg key "$KEY_B64" '. + {key:$key}' "$EXT_DIR/manifest.json" > "$STAGE/chrome/manifest.json"
else
  echo "NOTE: chrome-key.pem not found; chrome.zip has no pinned extension ID." >&2
fi
( cd "$STAGE/chrome" && \
  zip -qX "$DIST_DIR/$NAME-$VERSION-chrome.zip" manifest.json && \
  zip -qrX "$DIST_DIR/$NAME-$VERSION-chrome.zip" . -x manifest.json )

# --- Source zip: whole project (setup + host + extension + docs). ---
STAMP="$(date -u +%Y%m%d)"
STAGE_SRC="$STAGE/src/$NAME"
mkdir -p "$STAGE_SRC"
git -C "$REPO_DIR" ls-files -z | xargs -0 -I{} cp -a --parents {} "$STAGE_SRC"/ 2>/dev/null \
  || cp -a "$REPO_DIR"/. "$STAGE_SRC"/
rm -rf "$STAGE_SRC/.git" "$STAGE_SRC/dist" "$STAGE_SRC/chrome-key.pem" "$STAGE_SRC"/chrome-key-*.pem.bak "$STAGE_SRC/.env"
( cd "$STAGE/src" && zip -qr "$DIST_DIR/$NAME-$VERSION-$STAMP.zip" . )

cat <<EOF
Built in dist/:
  $NAME-$VERSION.xpi                                  (Firefox add-on)
  $NAME-$VERSION-listed.xpi                           (AMO listed submission upload)
  $NAME-$VERSION-chrome.zip                           (Chrome Web Store upload)
  $NAME-$VERSION-$STAMP.zip                           (Chrome family / source)

Store-free install (see INSTALL.md):
  Chrome/Chromium/Brave: unzip, ./bin/plugin-installer-setup --extension-dir ./extension,
                         then chrome://extensions -> Load unpacked -> extension/
  Firefox ESR/Dev Edition/Nightly: about:addons -> Install Add-on From File -> the .xpi
EOF
