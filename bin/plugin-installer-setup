#!/bin/bash
# Registers the Omarchy Browser Plugin Manager's native messaging host with
# the browsers, and prints the (manual) browser-extension loading steps.
#
# Browsers covered: Google Chrome, Chromium, Brave, Firefox.
# The host manifest is written per browser family:
#   - Chromium family: allowed_origins pinned to the extension ID derived from
#     the extension directory path (stable for "Load unpacked" at that path),
#     the key-pinned packed-install ID, and the Chrome Web Store item ID.
#   - Firefox: allowed_extensions pinned to both the self-distribution add-on
#     ID from the extension manifest's browser_specific_settings and the
#     AMO-listed add-on ID derived from the listing slug.

set -euo pipefail
export LC_ALL=C

HOST_NAME="bramvanoploo_omarchy_browser_plugin_manager"
FIREFOX_ADDON_ID="bramvanoploo.omarchy-browser-plugin-manager@bram.dev"
# AMO-listed add-on ID: MV3 listed submissions must declare an ID, the
# self-distribution ID is taken by unlisted signing, and "@addons.mozilla.org"
# IDs are reserved for AMO, so the listed add-on uses this fresh domain ID.
AMO_ADDON_ID="omarchy-browser-plugin-manager@sudo-systems.com"
# Chrome Web Store item ID, assigned by the store at first upload from the
# store-side keypair (the 2025+ CWS dashboard rejects manifests containing
# "key", so it is NOT derivable from chrome-key.pem). Copy from the dashboard.
CHROME_STORE_ID="nalcgjmbglkcmohokidcmogcbpmhkdjf"

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname -- "$SCRIPT_PATH")"
REPO_DIR="$(dirname -- "$BIN_DIR")"
HOST_PATH="$BIN_DIR/omarchy-plugin-install-host"
EXT_DIR="${PLUGIN_INSTALLER_EXT_DIR:-$REPO_DIR/extension}"

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CHROME_DIRS=(
  "$CONFIG_HOME/google-chrome"
  "$CONFIG_HOME/chromium"
  "$CONFIG_HOME/BraveSoftware/Brave-Browser"
)
# Firefox (Linux) scans native messaging manifests in the XDG location
# (~/.config/mozilla/... since Firefox 133) and the legacy ~/.mozilla one.
# Register in both; older Firefox builds only read the legacy path.
FIREFOX_DIRS=(
  "$CONFIG_HOME/mozilla/native-messaging-hosts"
  "$HOME/.mozilla/native-messaging-hosts"
)

usage() {
  cat <<EOF
Usage: plugin-installer-setup [--extension-dir PATH] [--uninstall]

  --extension-dir PATH  Directory that will be loaded as the unpacked
                        extension (default: $REPO_DIR/extension).
                        The Chrome/Chromium/Brave native-messaging origin is
                        derived from this path, so the extension must be
                        loaded from exactly this directory. Extra dirs are
                        remembered (state-dir extension-dirs.conf) and stay
                        registered when the plugin auto-registers on load.
  --uninstall           Remove the registered native messaging manifests.
EOF
}

uninstall() {
  local removed=0 dir
  for dir in "${CHROME_DIRS[@]}"; do
    if [[ -f "$dir/NativeMessagingHosts/$HOST_NAME.json" ]]; then
      rm -f "$dir/NativeMessagingHosts/$HOST_NAME.json"
      removed=1
    fi
  done
  for dir in "${FIREFOX_DIRS[@]}"; do
    if [[ -f "$dir/$HOST_NAME.json" ]]; then
      rm -f "$dir/$HOST_NAME.json"
      removed=1
    fi
  done
  echo "Native messaging manifests removed$([[ $removed == 1 ]] && echo ' (at least one)' || echo ' (none were present)')."
}

# Chrome extension ID for an unpacked extension = first 16 bytes of the
# SHA-256 of the absolute path, each nibble mapped 0->a ... f->p.
chrome_extension_id() {
  realpath "$1" | tr -d '\n' | sha256sum | cut -c1-32 \
    | tr '0123456789abcdef' 'abcdefghijklmnop'
}

# Stable Chrome extension ID derived from the manifest's "key" (public key):
# used by packed/zip installs. The source manifest carries no key (Firefox
# warns about it), so fall back to the repo's chrome-key.pem (when present)
# or the legacy pinned ID. The Chrome Web Store item ID is separate
# (CHROME_STORE_ID): the store derives it from its own keypair.
chrome_key_id() {
  local key=""
  key=$(jq -r '.key // ""' "$1" 2>/dev/null) || true
  if [[ -z $key && -f "$REPO_DIR/chrome-key.pem" ]]; then
    key=$(openssl pkey -in "$REPO_DIR/chrome-key.pem" -pubout -outform DER 2>/dev/null | base64 -w0) || true
  fi
  if [[ -z $key ]]; then
    printf '%s\n' "$CHROME_STORE_ID"
    return 0
  fi
  printf '%s' "$key" | base64 -d | sha256sum | cut -c1-32 \
    | tr '0123456789abcdef' 'abcdefghijklmnop'
}

main() {
  local ext_dir="$EXT_DIR"

  while (( $# > 0 )); do
    case "$1" in
      --extension-dir) ext_dir="${2:?--extension-dir requires a path}"; shift 2 ;;
      --uninstall) uninstall; exit 0 ;;
      -h|--help) usage; exit 0 ;;
      *) echo "Unknown argument: $1" >&2; usage >&2; exit 1 ;;
    esac
  done

  [[ -x $HOST_PATH ]] || chmod +x "$HOST_PATH"
  [[ -f "$ext_dir/manifest.json" ]] || {
    echo "Extension manifest not found at: $ext_dir/manifest.json" >&2
    exit 1
  }

  local chromium_id key_id chromium_manifest firefox_manifest dir ext_abs
  local id o skip
  local -a origins ext_dirs
  ext_abs=$(realpath "$ext_dir")

  # Persist every extension dir ever registered: the shell plugin
  # auto-registers on every load (no arguments, default dir). Without this
  # file, an auto-registration silently drops the origin of an unpacked
  # extension loaded from a dev checkout, and Chrome forbids connectNative
  # for it until setup is re-run by hand. One realpath'ed dir per line.
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/bramvanoploo.omarchy-browser-plugin-manager"
  local origins_conf="$state_dir/extension-dirs.conf"
  mkdir -p "$state_dir" 2>/dev/null || true
  ext_dirs=("$ext_abs")
  if [[ -f $origins_conf ]]; then
    while IFS= read -r dir; do
      [[ -n $dir && -f "$dir/manifest.json" ]] || continue
      skip=0
      for o in "${ext_dirs[@]}"; do [[ $o == "$dir" ]] && skip=1 && break; done
      (( skip )) || ext_dirs+=("$dir")
    done <"$origins_conf"
  fi
  printf '%s\n' "${ext_dirs[@]}" >"$origins_conf" 2>/dev/null || true

  # Pin the path-derived unpacked IDs (every registered dir: plugin folder,
  # dev checkouts), the key-pinned packed-install ID, and the Chrome Web
  # Store item ID so Load unpacked, zipped dev installs, and store installs
  # all reach the host.
  origins=()
  for dir in "${ext_dirs[@]}"; do
    chromium_id=$(chrome_extension_id "$dir")
    key_id=$(chrome_key_id "$dir/manifest.json")
    for id in "$chromium_id" "$key_id"; do
      [[ -n $id ]] || continue
      skip=0
      for o in "${origins[@]}"; do [[ $o == "chrome-extension://$id/" ]] && skip=1 && break; done
      (( skip )) || origins+=("chrome-extension://$id/")
    done
  done
  for id in "$CHROME_STORE_ID"; do
    [[ -n $id ]] || continue
    skip=0
    for o in "${origins[@]}"; do [[ $o == "chrome-extension://$id/" ]] && skip=1 && break; done
    (( skip )) || origins+=("chrome-extension://$id/")
  done

  chromium_manifest=$(jq -cn \
    --arg name "$HOST_NAME" \
    --arg path "$HOST_PATH" \
    '{name:$name, path:$path, type:"stdio",
      description:"Native messaging host for the Omarchy Browser Plugin Manager browser extension.",
      allowed_origins:($ARGS.positional)}' \
    --args "${origins[@]}")

  # Firefox REQUIRES "description" in the app manifest (Chrome ignores it):
  # without it NativeManifests.sys.mjs rejects the whole file and Firefox
  # reports "No such native application".
  firefox_addons=("$FIREFOX_ADDON_ID")
  [[ -n $AMO_ADDON_ID && $AMO_ADDON_ID != "$FIREFOX_ADDON_ID" ]] && firefox_addons+=("$AMO_ADDON_ID")
  firefox_manifest=$(jq -cn \
    --arg name "$HOST_NAME" \
    --arg path "$HOST_PATH" \
    '{name:$name, path:$path, type:"stdio",
      description:"Native messaging host for the Omarchy Browser Plugin Manager browser extension.",
      allowed_extensions:($ARGS.positional)}' \
    --args "${firefox_addons[@]}")

  for dir in "${CHROME_DIRS[@]}"; do
    mkdir -p "$dir/NativeMessagingHosts"
    printf '%s\n' "$chromium_manifest" >"$dir/NativeMessagingHosts/$HOST_NAME.json"
  done
  for dir in "${FIREFOX_DIRS[@]}"; do
    mkdir -p "$dir"
    printf '%s\n' "$firefox_manifest" >"$dir/$HOST_NAME.json"
  done

  # Park a standalone copy of this script for self-cleanup: when the plugin
  # folder is removed, the wizard's destruction hook spawns a detached
  # watcher that runs this copy with --uninstall. Manifest removal is
  # self-contained; the copy must never be run for registration from here
  # (its host path would point into the state dir, not the plugin folder).
  local state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/bramvanoploo.omarchy-browser-plugin-manager"
  mkdir -p "$state_dir" && cp -f "$SCRIPT_PATH" "$state_dir/plugin-installer-setup"

  cat <<EOF
Native messaging host registered:
  host:  $HOST_NAME
  path:  $HOST_PATH
  chrome/chromium/brave origins: ${origins[*]}
  firefox add-on:               $FIREFOX_ADDON_ID

Next steps (browser extensions must be loaded manually):

  Chrome / Chromium / Brave
    1. Open chrome://extensions (brave://extensions)
    2. Enable Developer mode
    3. Load unpacked -> select: $ext_abs
    (Load from exactly that path; the native host origin above is derived from it.)

  Firefox (>= 121, until the add-on is signed via AMO)
    1. Open about:debugging#/runtime/this-firefox
    2. Load Temporary Add-on -> select: $ext_dir/manifest.json
    (Temporary add-ons reset at every Firefox restart; reload them after restarts
     or ship a signed build via https://addons.mozilla.org.)

Verify the host answers the browser:
  printf '\\x0f\\x00\\x00\\x00{"type":"ping"}' | $HOST_PATH | tail -c +5 ; echo
EOF
}

main "$@"
