{
  "manifest_version": 3,
  "name": "Omarchy Browser Plugin Manager",
  "version": "0.4.0",
  "description": "Adds Install/Uninstall buttons to installable plugins on plugins.omarchy.org. Requires the Omarchy shell plugin and native host.",
  "permissions": [
    "nativeMessaging"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": [
        "https://plugins.omarchy.org/plugin.html*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://plugins.omarchy.org/",
        "https://plugins.omarchy.org/index.html*"
      ],
      "js": [
        "catalog.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bramvanoploo.omarchy-browser-plugin-manager@bram.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
