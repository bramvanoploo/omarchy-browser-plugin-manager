#!/bin/bash
# Read-only smoke test for the Chrome Web Store publish credentials.
# Proves the .env GOOGLE_CWS_* values work before any real publish:
#   1. mints an access token from the refresh token (no CWS call),
#   2. asks the Publish API for the item's status (:fetchStatus).
# Nothing here uploads or publishes anything.
#
# Usage: browser/store/bin/check-chrome-credentials

set -euo pipefail
export LC_ALL=C

SCRIPT_PATH="$(realpath "${BASH_SOURCE[0]}")"
BIN_DIR="$(dirname -- "$SCRIPT_PATH")"
REPO_DIR="$(dirname -- "$(dirname -- "$(dirname -- "$BIN_DIR")")")"
ENV_FILE="$REPO_DIR/.env"
ITEM_ID="${GOOGLE_CWS_ITEM_ID:-nalcgjmbglkcmohokidcmogcbpmhkdjf}"

[[ -f "$ENV_FILE" ]] || { echo "Missing .env at $ENV_FILE" >&2; exit 1; }
set -a; source "$ENV_FILE"; set +a
for key in GOOGLE_CWS_PUBLISHER_ID GOOGLE_CWS_CLIENT_ID GOOGLE_CWS_CLIENT_SECRET GOOGLE_CWS_REFRESH_TOKEN; do
  [[ -n "${!key:-}" ]] || {
    echo "$key is still empty in .env - finish the setup steps from browser/store/bin/publish-chrome's header." >&2
    exit 1
  }
done

echo -n "1/2 token mint ... "
TOKEN_RESP="$(curl -sS --max-time 45 https://oauth2.googleapis.com/token \
  --data-urlencode "client_id=$GOOGLE_CWS_CLIENT_ID" \
  --data-urlencode "client_secret=$GOOGLE_CWS_CLIENT_SECRET" \
  --data-urlencode "refresh_token=$GOOGLE_CWS_REFRESH_TOKEN" \
  --data-urlencode "grant_type=refresh_token")"
ACCESS_TOKEN="$(printf '%s' "$TOKEN_RESP" | jq -r '.access_token // empty')"
if [[ -z "$ACCESS_TOKEN" ]]; then
  echo "FAILED" >&2
  printf '%s\n' "$TOKEN_RESP" | jq '{error, error_description}' >&2
  echo "Meanings: invalid_client = client ID/secret mismatch; invalid_grant = refresh token revoked/expired (7-day Testing-mode token, wrong account, or consent screen changed)." >&2
  exit 1
fi
echo "ok (access token ${#ACCESS_TOKEN} chars)"

echo -n "2/2 item status ... "
STATUS="$(curl -sS --max-time 45 -H "Authorization: Bearer $ACCESS_TOKEN" \
  "https://chromewebstore.googleapis.com/v2/publishers/$GOOGLE_CWS_PUBLISHER_ID/items/$ITEM_ID:fetchStatus")"
if printf '%s' "$STATUS" | jq -e '.error' >/dev/null 2>&1; then
  echo "FAILED" >&2
  printf '%s\n' "$STATUS" | jq '.error' >&2
  echo "Meanings: 403 = publisher ID does not match the item, or the token's Google account is not the listing owner; 404 = wrong publisher ID or item ID." >&2
  exit 1
fi
echo "ok"
printf '%s\n' "$STATUS" | jq '{itemId, published: .publishedItemRevisionStatus.state, submitted: .submittedItemRevisionStatus.state, takenDown, warned}'
echo "Credentials are good: browser/store/bin/publish-chrome can run."
